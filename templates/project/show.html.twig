{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} - Détails{% endblock %}

{% block body %}
    {% include 'components/navbar.html.twig' %}

    <div class="container py-5">
        <a href="{{ path('app_projects') }}" class="text-secondary mb-4 d-inline-block">← Retour aux projets</a>
        
        <div class="row">
            <div class="col-lg-8">
                {% if project.image is defined %}
                    <div class="mb-4">
                        <img src="{{ asset('images/projets/' ~ project.image) }}" 
                             alt="{{ project.title }}" 
                             class="img-fluid rounded shadow" 
                             style="border: 1px solid var(--border-color); width: 100%;">
                    </div>
                {% endif %}

                <span class="tech-badge mb-3">{{ project.category }}</span>
                <h1 class="mb-4">{{ project.title }}</h1>
                
                <div class="project-description" style="white-space: pre-line; color: var(--text-color); line-height: 1.6;">
                 {{ project.description }}
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="project-card p-4">
                    <h4 class="mb-3">Technologies</h4>
                    <div class="tech mb-4">
                        {% for tech in project.technologies %}
                            <span class="tech-badge">{{ tech }}</span>
                        {% endfor %}
                    </div>
                    <p class="text-secondary"><strong>Date :</strong> {{ project.date }}</p>
                </div>
            </div>
        </div>
    </div>

    {% include 'components/footer.html.twig' %}
{% endblock %}