{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil - Portfolio{% endblock %}

{% block body %}
    {% include 'components/navbar.html.twig' with {'name': data.name} %}

    {# Hero Section #}
    <section class="hero container">
        <div class="row w-100 align-items-center">
            <div class="col-lg-8">
                <p class="section-title">Portfolio BUT RT</p>
                <h1>{{ data.name }}</h1>
                <p class="lead text-secondary mb-4">
                    {{ data.title }} à l'{{ data.school }}. {{ data.description }}
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="{{ path('app_projects') }}" class="btn btn-primary">Voir mes projets</a>
                    <a href="{{ path('app_contact') }}" class="btn btn-secondary">Me contacter</a>
                </div>
            </div>
        </div>
    </section>

    <div class="divider"></div>

    {# Stats Section #}
    <section class="container py-5">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="project-card">
                    <h3 class="display-4 mb-2">{{ data.stats.projects }}</h3>
                    <p class="text-secondary mb-0">Projets réalisés</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="project-card">
                    <h3 class="display-4 mb-2">{{ data.stats.technologies }}</h3>
                    <p class="text-secondary mb-0">Technologies maîtrisées</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="project-card">
                    <h3 class="display-4 mb-2">{{ data.stats.experience }}</h3>
                    <p class="text-secondary mb-0">D'expérience</p>
                </div>
            </div>
        </div>
    </section>

    <div class="divider"></div>

    {# Featured Projects #}
    <section class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Projets mis en avant</h2>
            <a href="{{ path('app_projects') }}" class="btn btn-secondary">Voir tous les projets</a>
        </div>
        <div class="row g-4">
            {% for project in data.featured_projects %}
                <div class="col-md-6 col-lg-4">
                    <div class="project-card">
                        <h3>{{ project.title }}</h3>
                        <p class="text-secondary">{{ project.description }}</p>
                        <div class="tech">
                            {% for tech in project.technologies %}
                                <span class="tech-badge">{{ tech }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <div class="divider"></div>

    {# CTA Section #}
    <section class="container py-5 text-center">
        <h2>Travaillons ensemble</h2>
        <p class="lead text-secondary mb-4">
            Je suis disponible pour des stages, alternances ou projets freelance.<br>
            N'hésitez pas à me contacter pour discuter de vos besoins.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="{{ path('app_contact') }}" class="btn btn-primary">Me contacter</a>
            <a href="{{ path('app_about') }}" class="btn btn-secondary">Voir mon parcours</a>
        </div>
    </section>

    {% include 'components/footer.html.twig' with {'name': data.name, 'github': data.github, 'linkedin': data.linkedin} %}
{% endblock %}